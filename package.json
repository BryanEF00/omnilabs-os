{
  "name": "omnilabs-os",
  "private": true,
  "workspaces": [
    "core-server",
    "os-client",
    "e2e-tests"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=core-server\" \"npm run dev --workspace=os-client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=core-server",
    "test:e2e": "npm run test --workspace=e2e-tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
