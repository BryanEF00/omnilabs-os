# ==============================================================
# OmniLabs OS - Configurações de Ambiente (Modelo de Exemplo)
# ==============================================================

# Servidor Fastify (Porta e IP local para a bancada do LD2 acessar)
PORT=3000
HOST=0.0.0.0

# Banco de Dados SQLite com Criptografia SQLCipher
DATABASE_PATH=omnilabs.db
DB_ENCRYPTION_KEY=substitua-por-uma-chave-aes-256-secreta-de-32-bytes

# Autenticação e Sessão Nominal
JWT_SECRET=substitua-por-um-segredo-jwt-forte-e-aleatorio
JWT_EXPIRES_IN=12h
